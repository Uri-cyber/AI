# =====================================================
# AI Troubleshooting Assistant Configuration
# =====================================================
# This file is OPTIONAL for local mode!
# Copy to .env only if you want to customize settings

# =====================================================
# OPTION 1: LOCAL MODE (Recommended - No tokens needed!)
# =====================================================
# Uses local AI - completely free, no API costs!

# Default provider (choose one):
# - "local" = Auto-detect (tries Ollama, falls back to rule-based)
# - "ollama" = Use Ollama local LLM (requires: ollama serve)
# - "rule-based" = Rule-based expert system (always works, no setup)

AI_PROVIDER=local

# Ollama settings (only if using Ollama)
OLLAMA_MODEL=llama2         # Options: llama2, mistral, codellama, phi, etc.
OLLAMA_HOST=http://localhost:11434

# =====================================================
# OPTION 2: CLOUD AI (Optional - Requires API tokens)
# =====================================================
# Only use this if you want cloud AI (costs money!)
# Uncomment the section below if needed:

# AI_PROVIDER=anthropic  # or "openai"
#
# # Anthropic API Key (for Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
#
# # OpenAI API Key (for GPT)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4-turbo-preview

# =====================================================
# QUICK START:
# =====================================================
# 1. No configuration needed! Just run: python main.py
# 2. It will use rule-based AI by default (works instantly)
# 3. For better AI, install Ollama: https://ollama.ai
#    Then run: ollama pull llama2
#    Then run: ollama serve
# 4. The app will auto-detect Ollama and use it!
